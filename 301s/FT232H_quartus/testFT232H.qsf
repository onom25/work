set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M25SCE144C8G
set_global_assignment -name TOP_LEVEL_ENTITY testFT232H
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "16:40:30  APRIL 16, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name SDC_FILE testFT232H.sdc
set_global_assignment -name BDF_FILE testFT232H.bdf
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "NO HEAT SINK WITH STILL AIR"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name DEVICE_FILTER_PACKAGE "ANY QFP"
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 144
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 8
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name FLOW_ENABLE_POWER_ANALYZER ON
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE "12.5 %"
set_location_assignment PIN_70 -to D[7]
set_location_assignment PIN_69 -to D[6]
set_location_assignment PIN_66 -to D[5]
set_location_assignment PIN_56 -to CLK
set_location_assignment PIN_65 -to D[4]
set_location_assignment PIN_64 -to D[3]
set_location_assignment PIN_62 -to D[2]
set_location_assignment PIN_61 -to D[1]
set_location_assignment PIN_60 -to D[0]
set_location_assignment PIN_50 -to nRXF
set_location_assignment PIN_52 -to nTXE
set_location_assignment PIN_26 -to NRES
set_location_assignment PIN_54 -to nSIWU
set_location_assignment PIN_55 -to nPWRSAV
set_location_assignment PIN_57 -to nRD
set_location_assignment PIN_58 -to nWR
set_location_assignment PIN_59 -to nOE
set_location_assignment PIN_93 -to UISW1
set_location_assignment PIN_92 -to UISW2
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name ENABLE_SIGNALTAP OFF
set_global_assignment -name USE_SIGNALTAP_FILE uisw.stp
set_global_assignment -name SIGNALTAP_FILE nRD001.stp
set_location_assignment PIN_100 -to TP1
set_location_assignment PIN_101 -to TP2
set_global_assignment -name SIGNALTAP_FILE uisw.stp
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top